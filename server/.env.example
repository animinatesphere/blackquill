# Port the backend listens on
PORT=4000

# The frontend origin(s) allowed to call this API, comma-separated
# In production this should be your Vercel domain(s), e.g. https://blackquill.ng,https://www.blackquill.ng
FRONTEND_URL=http://localhost:5173

# Password for the /admin login (choose something strong)
ADMIN_PASSWORD=change-me

# Resend (https://resend.com) API key for sending emails
RESEND_API_KEY=

# The "from" address used when sending emails — must be a verified domain/sender in Resend
EMAIL_FROM=BlackQuill <hello@blackquill.ng>

# Where new-enquiry notification emails are sent
CONTACT_NOTIFY_EMAIL=cleaniqservices@gmail.com

NODE_ENV=production
